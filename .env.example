# ============================================
# CONFIGURACIÓN DE GOOGLE SHEETS API
# ============================================
# 
# INSTRUCCIONES PARA OBTENER ESTOS VALORES:
# 
# 1. GOOGLE_SPREADSHEET_ID:
#    - Crea una hoja de Google Sheets
#    - Copia SOLO el ID de la URL (no la URL completa)
#    - Formato: https://docs.google.com/spreadsheets/d/[COPIA_SOLO_ESTE_ID]/edit
#    - Ejemplo: 1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms
#
# 2. GOOGLE_CLIENT_EMAIL:
#    - Crea un Service Account en Google Cloud Console
#    - Descarga el archivo JSON de credenciales
#    - Copia el valor del campo "client_email"
#    - Ejemplo: qr-scanner@tu-proyecto.iam.gserviceaccount.com
#
# 3. GOOGLE_PRIVATE_KEY:
#    - Del mismo archivo JSON, copia el valor del campo "private_key"
#    - IMPORTANTE: Mantén los \n (saltos de línea escapados)
#    - Debe comenzar con -----BEGIN PRIVATE KEY-----\n
#    - Debe terminar con \n-----END PRIVATE KEY-----\n
#
# 4. Compartir la hoja de Google Sheets:
#    - Haz clic en "Compartir" en tu hoja
#    - Agrega el GOOGLE_CLIENT_EMAIL como "Editor"
#
# Ver guía completa en QUICKSTART.md

# ID de la hoja de Google Sheets (SOLO EL ID, NO LA URL COMPLETA)
GOOGLE_SPREADSHEET_ID=tu_id_de_spreadsheet_aqui

# Email del Service Account (del archivo JSON de credenciales)
GOOGLE_CLIENT_EMAIL=tu-service-account@tu-proyecto.iam.gserviceaccount.com

# Clave privada del Service Account (del archivo JSON)
# IMPORTANTE: Debe incluir \n para los saltos de línea
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTuClavePrivadaCompleta\n-----END PRIVATE KEY-----\n"

# Puerto del servidor (Render lo asigna automáticamente en producción)
PORT=3000

# Ambiente de ejecución
NODE_ENV=development

# ============================================
# CONFIGURACIÓN DE CORREO SMTP
# ============================================
# Para Gmail: usa SMTP_SERVICE=gmail y una contraseña de aplicación (no tu contraseña normal)
# Para Outlook/Hotmail: usa SMTP_HOST=smtp-mail.outlook.com, SMTP_PORT=587
# Para otros: usa SMTP_HOST con el servidor SMTP de tu proveedor

# Servicio predefinido (opcional, si es Gmail o Outlook usa esta opción)
# SMTP_SERVICE=gmail

# Host del servidor SMTP (requerido si no usas SMTP_SERVICE)
SMTP_HOST=smtp.tu-proveedor.com

# Puerto SMTP: 587 para TLS/STARTTLS, 465 para SSL
SMTP_PORT=587

# true = SSL directo (puerto 465), false = STARTTLS (puerto 587)
SMTP_SECURE=false

# Usuario de autenticación SMTP (generalmente tu correo)
SMTP_USER=tu-correo@dominio.com

# Contraseña de aplicación SMTP (no usar contraseña personal en Gmail, generar en Seguridad de Google)
SMTP_PASS=tu-contraseña-de-aplicacion

# Dirección "De:" que aparece en los correos enviados
SMTP_FROM=no-reply@gobyfilters.com
